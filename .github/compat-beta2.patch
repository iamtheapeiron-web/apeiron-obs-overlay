+function Test-MouseVk([int]$vk) {
+    return ($vk -in @(0x01,0x02,0x04,0x05,0x06))
+}
+
+function Get-InputModeText {
+    if ([bool]$cfg.general.compatibilityMode) { return "Polling-only compatibility mode (no low-level hooks)" }
+    if (-not $script:hookStarted -and ($script:keyboardHookWanted -or $script:mouseHookWanted)) { return "Polling fallback (requested hook unavailable)" }
+    $keyboard=[ApeironGlobalInput]::KeyboardHookActive()
+    $mouse=[ApeironGlobalInput]::MouseHookActive()
+    if ($keyboard -and $mouse) { return "Keyboard + mouse hooks" }
+    if ($keyboard) { return "Keyboard hook only" }
+    if ($mouse) { return "Mouse hook only" }
+    return "Polling only (no active hotkey hook required)"
+}
+
+function Update-InputHooks {
+    $wantKeyboard=$false
+    $wantMouse=$false
+    if (-not [bool]$cfg.general.compatibilityMode) {
+        foreach ($entry in @(
+            @([bool]$cfg.toggle.enabled,[int]$cfg.toggle.vk),
+            @([bool]$cfg.hold.enabled,[int]$cfg.hold.vk)
+        )) {
+            if (-not [bool]$entry[0]) { continue }
+            if (Test-MouseVk ([int]$entry[1])) { $wantMouse=$true } else { $wantKeyboard=$true }
+        }
+    }
+
+    $changed=(-not $script:hookConfigInitialized -or $wantKeyboard -ne $script:keyboardHookWanted -or $wantMouse -ne $script:mouseHookWanted -or (-not $script:hookStarted -and ($wantKeyboard -or $wantMouse)))
+    if ($changed) {
+        try { [ApeironGlobalInput]::Stop() } catch {}
+        $script:keyboardHookWanted=$wantKeyboard
+        $script:mouseHookWanted=$wantMouse
+        $script:hookConfigInitialized=$true
+        $script:hookStarted=[ApeironGlobalInput]::Start($wantKeyboard,$wantMouse)
+    }
+
+    if ($null -ne $fastTimer) { $fastTimer.Interval=if([bool]$cfg.general.compatibilityMode){25}else{35} }
+    $mode=Get-InputModeText
+    if ($null -ne $lblInputMode) { $lblInputMode.Text="Input mode: $mode" }
+    if (-not $script:hookStarted) {
+        $lblBottom.Text="Ready — requested hook failed; polling fallback active"
+    } elseif ([bool]$cfg.general.compatibilityMode) {
+        $lblBottom.Text="Ready — compatibility mode (polling only)"
+    } elseif ($wantKeyboard -or $wantMouse) {
+        $lblBottom.Text="Ready — $mode"
+    } else {
+        $lblBottom.Text="Ready — no global hooks needed"
+    }
+}
+
 function Sync-ControlInput {
+    Update-InputHooks
     [ApeironGlobalInput]::ClearPresses()
     $script:toggleWasDown=Vk-IsDown ([int]$cfg.toggle.vk)
     $script:holdWasDown=Vk-IsDown ([int]$cfg.hold.vk)
